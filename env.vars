export NUTANIX_USER='admin' # Prism Central Username (local user)
export NUTANIX_PASSWORD='password' # Prism Central Password (local user)
export NUTANIX_ENDPOINT='https://x.x.x.x:9440' # Prism Central URL
export IMAGE='nkp-ubuntu-24.04-release-cis-1.34.3-20260504025514.qcow2'
export CONTROL_PLANE_SUBNET='UPDATE' # Subnet where control plane nodes will be deployed
export WORKER_SUBNET='UPDATE'
export CLUSTER_NAME='nkp' # NKP Management Cluster name
export CONTROLPLANE_VIP='x.x.x.x' # Control Plane VIP (Must be outside of DHCP range)
export LB_IP_RANGE='x.x.x.x-x.x.x.x' # Load Balancer IP range (Must be outside of DHCP range)
export PC_WORKER_CLUSTER_NAME='CLUSTER_NAME' # Where worker nodes will be deployed
export PC_CONTROL_PLANE_CLUSTER_NAME='CLUSTER_NAME' # Where control plane nodes will be deployed
export STORAGE_CONTAINER='SelfServiceContainer' # Prism Central Storage Container where the requested Persistent Volume Claims will get their volumes created
export SSH_USERNAME='nutanix' # Optional: SSH username to be used to ssh into kubernetes nodes
export SSH_PUBLIC_KEY="${HOME}/.ssh/id_ed25519.pub" # Optional: SSH public key file to be used to ssh into kubernetes nodes
export LOCAL_REGISTRY_INSTALL=false # Whether to install a local Harbor registry. False will use the internal registry in mgmt cluster (2.16+ feature)
export PROJECT_NAME='nkp-internal' # Name of the project to create in Harbor if LOCAL_REGISTRY_INSTALL=true, needs to be dns friendly
export AIRGAPPED=false # Whether to use airgapped mode. Requires airgapped bundle.
export NKP_VERSION=$(nkp version -o json | jq .nkp.gitVersion -r)